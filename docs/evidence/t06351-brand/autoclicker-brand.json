{
  "name": "autoclicker",
  "label": "AutoClicker",
  "version": 1,
  "raw": {
    "blue800": "#0D47A1",
    "blue700": "#1765CC",
    "blue600": "#1A73E8",
    "blue500": "#4285F4",
    "blue50": "#E8F0FE",
    "orange500": "#FF9800",
    "white": "#FFFFFF",
    "gray50": "#F6F7F9",
    "gray100": "#EEF1F4",
    "ink900": "#16181D",
    "ink700": "#4B5563",
    "ink600": "#5B6472",
    "line": "#E5E7EB",
    "lineStrong": "#D1D5DB"
  },
  "semantic": {
    "brand": "raw.blue700",
    "brand-hover": "raw.blue600",
    "brand-pressed": "raw.blue800",
    "brand-ink": "raw.blue800",
    "brand-soft": "raw.blue50",
    "bg": "raw.white",
    "surface": "raw.gray50",
    "surface-2": "raw.gray100",
    "card": "raw.white",
    "ink": "raw.ink900",
    "ink-2": "raw.ink700",
    "muted": "raw.ink600",
    "line": "raw.line",
    "line-strong": "raw.lineStrong",
    "ff": "\"Microsoft YaHei\",\"PingFang SC\",\"Segoe UI\",system-ui,sans-serif",
    "ff-mono": "Consolas,\"Cascadia Mono\",\"SFMono-Regular\",monospace",
    "fs-2xs": "12px",
    "fs-xs": "14px",
    "fs-sm": "16px",
    "fs-md": "20px",
    "fs-lg": "28px",
    "r-xs": "6px",
    "r-sm": "8px",
    "r-md": "12px",
    "r-lg": "16px",
    "shadow": "0 1px 2px rgba(16,24,40,.06), 0 4px 12px rgba(16,24,40,.08)",
    "motion-fast": "120ms",
    "motion-base": "200ms",
    "motion-slow": "240ms",
    "motion-ease": "cubic-bezier(.2,.8,.2,1)"
  },
  "component": {
    "button.primary.background": "semantic.brand",
    "button.primary.foreground": "raw.white",
    "button.primary.hover.background": "semantic.brand-hover",
    "button.primary.pressed.background": "semantic.brand-pressed",
    "button.primary.radius": "semantic.r-sm",
    "badge.brand.background": "semantic.brand-soft",
    "badge.brand.foreground": "semantic.brand-ink",
    "brandMark.background": "semantic.brand",
    "brandMark.foreground": "raw.white",
    "brandMark.radius": "semantic.r-sm",
    "card.background": "semantic.card",
    "card.border": "semantic.line",
    "card.radius": "semantic.r-lg",
    "card.shadow": "semantic.shadow"
  }
}
