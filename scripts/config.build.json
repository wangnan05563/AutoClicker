{
  "schema_version": 2,
  "project": {
    "name": "AutoClicker",
    "main_script": "auto_clicker_py3.py"
  },
  "build": {
    "release_dir": "release",
    "dist_dir": "release/dist",
    "build_dir": "release/build",
    "spec_dir": "scripts",
    "exe_name": "AutoClicker.exe",
    "package_mode": "onedir",
    "build_script": "scripts/build_exe.py",
    "build_ps1": "scripts/build_package.ps1",
    "pyinstaller": {
      "module": "PyInstaller",
      "pip_package": "pyinstaller",
      "flags": [
        "--onedir",
        "--windowed",
        "--noconfirm",
        "--clean"
      ],
      "icon": "icons/autoclicker.ico",
      "add_data": [
        {
          "source": "icons",
          "target": "icons"
        },
        {
          "source": "package.json",
          "target": "."
        }
      ],
      "hidden_imports": [
        "pyautogui",
        "keyboard",
        "PIL",
        "PIL.Image",
        "PIL.ImageTk",
        "tkinter",
        "tkinter.ttk",
        "win32gui",
        "win32api",
        "win32con"
      ],
      "optional_hidden_imports": [
        "ttkbootstrap",
        "ttkbootstrap.style",
        "ttkbootstrap.widgets"
      ],
      "exclude_modules": [
        "cv2",
        "numpy",
        "psutil",
        "yaml",
        "mouseinfo"
      ]
    },
    "clean_paths": [
      "release/build",
      "release/dist",
      "__pycache__",
      ".pytest_cache"
    ]
  },
  "runtime": {
    "python_min_version": [3, 10],
    "python_io_encoding": "utf-8",
    "required_imports": [
      "tkinter"
    ],
    "publish_preflight_imports": [
      "tkinter",
      "pyautogui",
      "keyboard",
      "win32gui",
      "win32api",
      "win32con",
      "PIL"
    ],
    "python_candidates": [
      "%LOCALAPPDATA%\\Programs\\Python\\Python314\\python.exe",
      "%LOCALAPPDATA%\\Programs\\Python\\Python313\\python.exe",
      "%LOCALAPPDATA%\\Programs\\Python\\Python312\\python.exe",
      "%LOCALAPPDATA%\\Programs\\Python\\Python311\\python.exe",
      "%LOCALAPPDATA%\\Programs\\Python\\Python310\\python.exe"
    ]
  },
  "build_safeguards": {
    "stop_before_build": {
      "enabled": true,
      "image_name": "AutoClicker.exe",
      "wait_seconds": 1
    }
  },
  "verification": {
    "min_exe_size_mb": 5,
    "launch_smoke_test": {
      "enabled": true,
      "timeout_seconds": 10,
      "stable_seconds": 5
    },
    "freshness_check": {
      "enabled": true,
      "source_dir": ".",
      "source_extensions": [
        ".py",
        ".spec"
      ]
    }
  },
  "release": {
    "version": "2.0.2",
    "arch": "win64",
    "package_name": "AutoClicker-{version}-{arch}",
    "archive_extension": ".zip",
    "overwrite_existing": true,
    "unique_suffix_format": "yyyyMMdd-HHmmss",
    "output_dir": "release/publish",
    "include": [
      "README.md",
      "LICENSE"
    ],
    "installer": {
      "enabled": true,
      "template": "scripts/installer.nsi",
      "name": "AutoClicker-{version}-{build}-{arch}-Setup",
      "extension": ".exe",
      "min_size_mb": 15,
      "tool_candidates": [
        "C:\\Program Files (x86)\\NSIS\\makensis.exe",
        "C:\\Program Files\\NSIS\\makensis.exe",
        "makensis.exe"
      ]
    }
  }
}
