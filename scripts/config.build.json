{
  "project": {
    "name": "AutoClicker",
    "main_script": "auto_clicker_py3.py",
    "root": "."
  },
  "build": {
    "dist_dir": "release/dist",
    "build_dir": "release/build",
    "exe_name": "AutoClicker.exe",
    "build_script": "scripts/build_exe.py",
    "exclude_modules": [
      "cv2"
    ]
  },
  "runtime": {
    "python_min_version": [3, 10],
    "python_candidates": [
      "%LOCALAPPDATA%\\Programs\\Python\\Python313\\python.exe",
      "%LOCALAPPDATA%\\Programs\\Python\\Python312\\python.exe",
      "%LOCALAPPDATA%\\Programs\\Python\\Python311\\python.exe",
      "F:\\Program Files\\Python3.14\\python.exe",
      "%USERPROFILE%\\.workbuddy\\binaries\\python\\versions\\3.13.12\\python.exe",
      "%USERPROFILE%\\.workbuddy\\binaries\\python\\versions\\3.14\\python.exe"
    ]
  },
  "build_safeguards": {
    "stop_before_build": {
      "enabled": true,
      "image_name": "AutoClicker.exe"
    }
  },
  "verification": {
    "min_exe_size_mb": 5,
    "launch_smoke_test": {
      "enabled": true,
      "timeout_seconds": 10
    }
  },
  "release": {
    "version": "2.0",
    "arch": "win64",
    "package_name": "AutoClicker-{version}-{arch}",
    "output_dir": "release/publish",
    "include": [
      "README.md",
      "LICENSE"
    ]
  }
}
