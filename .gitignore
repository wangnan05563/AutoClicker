# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg

# PyInstaller 自动生成的 spec（构建时由 build_exe.py 重新生成）
/scripts/AutoClicker.spec

# 机器相关的构建配置覆盖（含本机 Python 路径，不入库；模板见 config.build.local.example.json）
/scripts/config.build.local.json

# 虚拟环境
.venv/
venv/
env/

# 构建版本号状态（每次构建递增，机器本地状态，不入库）
/scripts/.build-version-state.json

# 构建产物（release 下保留 dist 供分发，其余全部忽略）
release/

# IDE / 编辑器
.idea/
.vscode/
*.swp

# 系统 / 工具
.trae/
.DS_Store
Thumbs.db

# 日志与缓存
*.log
.pytest_cache/

# SonarQube 扫描临时目录
.scannerwork/

# 代理/助手工作目录（含个人数据，绝不入库）
.workbuddy-ai/
.workbuddy/

# 环境变量 / 密钥（含 GitHub Token，绝不入库）
.env

# ---------- 可重复构建产物（2026-11-16 统一收口）----------
# PyInstaller 构建中间目录与输出目录（由 scripts/build_exe.py 重建）；release/ 已在上方单独忽略
build/
dist/
